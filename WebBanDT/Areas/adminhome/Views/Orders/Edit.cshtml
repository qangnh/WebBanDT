@model WebBanDT.Models.Order

@{
    ViewBag.Title = "Chỉnh sửa đơn hàng";
    Layout = "~/Areas/AdminHome/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="mb-4">Chỉnh sửa đơn hàng</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.OrderID)

    <div class="row g-3">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="col-md-6">
            @Html.LabelFor(model => model.CustomerID, "Khách hàng", htmlAttributes: new { @class = "form-label" })
            @Html.DropDownList("CustomerID", null, "-- Chọn khách hàng --", new { @class = "form-select" })
            @Html.ValidationMessageFor(model => model.CustomerID, "", new { @class = "text-danger" })
        </div>

        <div class="col-md-6">
            @Html.LabelFor(model => model.OrderDate, "Ngày đặt hàng", htmlAttributes: new { @class = "form-label" })
            @Html.EditorFor(model => model.OrderDate, new { htmlAttributes = new { @class = "form-control", @type = "datetime-local" } })
            @Html.ValidationMessageFor(model => model.OrderDate, "", new { @class = "text-danger" })
        </div>

        <div class="col-md-6">
            @Html.LabelFor(model => model.TotalAmount, "Tổng tiền", htmlAttributes: new { @class = "form-label" })
            @Html.EditorFor(model => model.TotalAmount, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập tổng tiền..." } })
            @Html.ValidationMessageFor(model => model.TotalAmount, "", new { @class = "text-danger" })
        </div>

        <div class="col-md-6">
            @Html.LabelFor(model => model.PaymentStatus, "Trạng thái thanh toán", htmlAttributes: new { @class = "form-label" })
            @Html.DropDownListFor(model => model.PaymentStatus, (SelectList)ViewBag.PaymentStatusList, "-- Chọn trạng thái --", new { @class = "form-select" })
            @Html.ValidationMessageFor(model => model.PaymentStatus, "", new { @class = "text-danger" })
        </div>

        <div class="col-md-12">
            @Html.LabelFor(model => model.DeliveryAddress, "Địa chỉ giao hàng", htmlAttributes: new { @class = "form-label" })
            @Html.EditorFor(model => model.DeliveryAddress, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập địa chỉ giao hàng..." } })
            @Html.ValidationMessageFor(model => model.DeliveryAddress, "", new { @class = "text-danger" })
        </div>

        <div class="col-md-6">
            @Html.LabelFor(model => model.OrderStatus, "Trạng thái đơn hàng", htmlAttributes: new { @class = "form-label" })
            @Html.DropDownListFor(model => model.OrderStatus, (SelectList)ViewBag.OrderStatusList, "-- Chọn trạng thái --", new { @class = "form-select" })
            @Html.ValidationMessageFor(model => model.OrderStatus, "", new { @class = "text-danger" })
        </div>

        <div class="col-12 mt-3">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-save"></i> Lưu thay đổi
            </button>
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary ms-2" })
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
