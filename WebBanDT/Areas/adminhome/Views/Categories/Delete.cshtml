@model WebBanDT.Models.Category

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/AdminHome/Views/Shared/_AdminLayout.cshtml";
}

<h2>Xóa danh mục</h2>

<div>
    <h4>Category</h4>
    <hr />

    <dl class="dl-horizontal">
        <dt>@Html.DisplayNameFor(m => m.CategoryName)</dt>
        <dd>@Html.DisplayFor(m => m.CategoryName)</dd>

        <dt>@Html.DisplayNameFor(m => m.Description)</dt>
        <dd>@Html.DisplayFor(m => m.Description)</dd>

        <dt>@Html.DisplayNameFor(m => m.CreatedAt)</dt>
        <dd>@Html.DisplayFor(m => m.CreatedAt)</dd>
    </dl>

    @if (ViewBag.CanDelete == false)
    {
        <div class="alert alert-warning">
            Danh mục này đang được sử dụng cho sản phẩm trên web, bạn không thể xóa.
        </div>

        <div class="form-actions no-color">
            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-default" })
        </div>
    }
    else
    {
        <h3>Bạn có chắc chắn muốn xóa danh mục này?</h3>

        using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-actions no-color">
                <input type="submit" value="Delete" class="btn btn-danger" /> |
                @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-default" })
            </div>
        }
    }
</div>
