@model PagedList.IPagedList<WebBanDT.Models.OrderDetail>
@using PagedList.Mvc;

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Areas/AdminHome/Views/Shared/_AdminLayout.cshtml";
}

<h2>Chi tiết đơn hàng</h2>

<div class="mb-3">
    @using (Html.BeginForm("Index", "OrderDetails", FormMethod.Get, new { @class = "d-flex" }))
    {
        <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control me-2" placeholder="🔍 Tìm theo tên sản phẩm..." />
        <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
    }
</div>

<p>
    @Html.ActionLink("Tạo mới", "Create", null, new { @class = "btn btn-primary mb-3" })
</p>

<table class="table table-bordered table-hover align-middle text-center">
    <thead class="table-light">
        <tr>
            <th>Tên sản phẩm</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>Trạng thái thanh toán</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@(item.Product?.ProductName ?? "Không có")</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("N0") đ</td>
                <td>@(item.Order?.PaymentStatus ?? "Chưa có")</td>
                <td>
                    @Html.ActionLink("Sửa", "Edit", new { id = item.OrderDetailID }, new { @class = "btn btn-sm btn-warning me-1" })
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.OrderDetailID }, new { @class = "btn btn-sm btn-info me-1" })
                    @Html.ActionLink("Xóa", "Delete", new { id = item.OrderDetailID }, new { @class = "btn btn-sm btn-danger" })
                </td>
            </tr>
        }
    </tbody>
</table>
<div class="d-flex justify-content-center mt-3">
    @Html.PagedListPager(
        Model,
        page => Url.Action("Index", new { page, searchString = ViewBag.SearchString }),
        new PagedListRenderOptions
        {
            DisplayLinkToFirstPage = PagedListDisplayMode.Always,
            DisplayLinkToLastPage = PagedListDisplayMode.Always,
            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
            DisplayLinkToNextPage = PagedListDisplayMode.Always,
            MaximumPageNumbersToDisplay = 5,
            UlElementClasses = new[] { "pagination", "justify-content-center" },
            LiElementClasses = new[] { "page-item" },
            ContainerDivClasses = new[] { "d-flex", "justify-content-center" },
            DisplayEllipsesWhenNotShowingAllPageNumbers = true,
            LinkToPreviousPageFormat = "«",
            LinkToNextPageFormat = "»",
            LinkToFirstPageFormat = "Trang đầu",
            LinkToLastPageFormat = "Trang cuối"
        }
    )
</div>
<style>
    .pagination > li > a,
    .pagination > li > span {
        color: #0d6efd;
        border: 1px solid #dee2e6;
        padding: 8px 12px;
        border-radius: 6px;
        margin: 0 3px;
        text-decoration: none;
    }

    .pagination > .active > a {
        background-color: #0d6efd !important;
        border-color: #0d6efd !important;
        color: white !important;
    }
</style>