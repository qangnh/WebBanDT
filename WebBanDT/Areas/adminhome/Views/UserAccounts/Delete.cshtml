@model WebBanDT.Models.UserAccount

@{
    ViewBag.Title = "Xóa tài khoản";
    Layout = "~/Areas/AdminHome/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">Xóa tài khoản</h5>
        </div>

        <div class="card-body">
            <p>Bạn có chắc muốn xóa tài khoản <strong>@Model.Username</strong> không?</p>
            <dl class="row">
                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>
                <dt class="col-sm-3">Vai trò</dt>
                <dd class="col-sm-9">@Model.UserRole</dd>
                <dt class="col-sm-3">Ngày tạo</dt>
                <dd class="col-sm-9">@Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</dd>
            </dl>

            @using (Html.BeginForm("Delete", "UserAccounts", FormMethod.Post, new { @id = "deleteForm" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.UserID)
                <button type="submit" class="btn btn-danger me-2">Xóa</button>
                @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary" })
            }
        </div>
    </div>
</div>
