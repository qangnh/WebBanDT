@using PagedList.Mvc;
@model PagedList.IPagedList<WebBanDT.Models.Customer>

@{
    ViewBag.Title = "Danh sách khách hàng";
    Layout = "~/Areas/AdminHome/Views/Shared/_AdminLayout.cshtml";

    var customerHasOrders = ViewBag.CustomerHasOrders as List<int> ?? new List<int>();
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
           
        </div>

        <div class="card-body">

            @* Thông báo từ TempData *@
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }

            <!-- ✅ Form tìm kiếm -->
            @using (Html.BeginForm("Index", "Customers", FormMethod.Get, new { area = "AdminHome", @class = "d-flex mb-3" }))
            {
                <input type="text"
                       name="searchString"
                       value="@ViewBag.CurrentFilter"
                       class="form-control me-2"
                       placeholder="🔍 Nhập tên, SĐT hoặc email để tìm..." />
                <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
            }

            <!-- ✅ Bảng dữ liệu -->
            <table class="table table-hover align-middle text-center">
                <thead class="table-light">
                    <tr>
                        <th>Tên khách hàng</th>
                        <th>Điện thoại</th>
                        <th>Email</th>
                        <th>Địa chỉ</th>
                        <th>Tài khoản</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.CustomerName</td>
                                <td>@item.CustomerPhone</td>
                                <td>@item.CustomerEmail</td>
                                <td>@item.CustomerAddress</td>
                                <td>@item.Username</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        @Html.ActionLink(
                                            "🔍 Xem", "Details", "Customers",
                                            new { id = item.CustomerID, area = "AdminHome" },
                                            new { @class = "btn btn-info btn-sm me-1 text-white" }
                                        )

                                        

                                        @if (customerHasOrders.Contains(item.CustomerID))
                                        {
                                            <button class="btn btn-secondary btn-sm" disabled
                                                    title="Khách hàng này đã có đơn hàng, không thể xóa">
                                                🚫 Không thể xóa
                                            </button>
                                        }
                                        else
                                        {
                                            @Html.ActionLink(
                                                "🗑️ Xóa", "Delete", "Customers",
                                                new { id = item.CustomerID, area = "AdminHome" },
                                                new
                                                {
                                                    @class = "btn btn-danger btn-sm",
                                                    onclick = "return confirm('Bạn có chắc muốn xóa khách hàng này không?');"
                                                }
                                            )
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-muted fst-italic">Không tìm thấy khách hàng nào</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="d-flex justify-content-center mt-3">
                @Html.PagedListPager(
                    Model,
                    page => Url.Action("Index", new { page, searchString = ViewBag.CurrentFilter }),
                    new PagedListRenderOptions
                    {
                        DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                        DisplayLinkToLastPage = PagedListDisplayMode.Always,
                        DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                        DisplayLinkToNextPage = PagedListDisplayMode.Always,
                        MaximumPageNumbersToDisplay = 5,
                        UlElementClasses = new[] { "pagination", "justify-content-center" },
                        LiElementClasses = new[] { "page-item" },
                        ContainerDivClasses = new[] { "d-flex", "justify-content-center" },
                        DisplayEllipsesWhenNotShowingAllPageNumbers = true,
                        LinkToPreviousPageFormat = "«",
                        LinkToNextPageFormat = "»",
                        LinkToFirstPageFormat = "Trang đầu",
                        LinkToLastPageFormat = "Trang cuối"
                    }
                )
            </div>
        </div>
    </div>
</div>

<style>
    .pagination > li > a,
    .pagination > li > span {
        color: #0d6efd;
        border: 1px solid #dee2e6;
        padding: 8px 12px;
        border-radius: 6px;
        margin: 0 3px;
        text-decoration: none;
    }

    .pagination > .active > a {
        background-color: #0d6efd !important;
        border-color: #0d6efd !important;
        color: white !important;
    }
</style>
