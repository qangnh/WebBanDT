<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - QUẢN TRỊ WEBSITE</title>
    <link href="~/Content/AdminHome/admin-style.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    @RenderSection("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand" href="@Url.Action("Index", "Home", new { area = "AdminHome" })">
                <img src="~/Image/GooD Phone.png" alt="Logo" /> Admin
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarCollapse">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li>@Html.ActionLink("Trang chủ", "Index", "Home", new { area = "AdminHome" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Danh mục", "Index", "Categories", new { area = "AdminHome" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Sản phẩm", "Index", "Products", new { area = "AdminHome" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Khách hàng", "Index", "Customers", new { area = "AdminHome" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Đơn hàng", "Index", "Orders", new { area = "AdminHome" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Chi tiết đơn hàng", "Index", "OrderDetails", new { area = "AdminHome" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Tài khoản", "Index", "UserAccounts", new { area = "AdminHome" }, new { @class = "nav-link" })</li>                    
                </ul>
                <form class="d-flex">
                    <input class="form-control me-2" type="search" placeholder="Tìm kiếm..." />
                    <button class="btn btn-outline-warning" type="submit">Tìm</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="body-content" style="margin-top: 70px;">
        @RenderBody()
        <hr />
    </div>

    <footer>
        <p>&copy; @DateTime.Now.Year - Hệ thống quản trị website</p>
        <p>Liên hệ: <a href="#">Nhóm phát triển</a></p>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
