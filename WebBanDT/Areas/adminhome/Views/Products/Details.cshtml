@model WebBanDT.Models.Product

@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Areas/AdminHome/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0">Chi tiết sản phẩm</h5>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Tên sản phẩm</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.ProductName)</dd>

                <dt class="col-sm-3">Mô tả sản phẩm</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.ProductDescription)</dd>

                <dt class="col-sm-3">Giá bán</dt>
                <dd class="col-sm-9">@String.Format("{0:N0} đ", Model.ProductPrice)</dd>

                <dt class="col-sm-3">Số lượng tồn kho</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.StockQuantity)</dd>

                <dt class="col-sm-3">Hình ảnh</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.ProductImage))
                    {
                        <img src="@Model.ProductImage" alt="Ảnh sản phẩm" class="img-fluid rounded" style="max-height: 200px;" />
                    }
                    else
                    {
                        <span class="text-muted">Chưa có hình ảnh</span>
                    }
                </dd>

                <dt class="col-sm-3">Ngày tạo</dt>
                <dd class="col-sm-9">@Model.CreatedAt?.ToString("dd/MM/yyyy")</dd>

                <dt class="col-sm-3">Hiển thị</dt>
                <dd class="col-sm-9">
                    @(Model.IsActive == true ? "Có" : "Không")
                </dd>

                <dt class="col-sm-3">Danh mục</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Category.CategoryName)</dd>
            </dl>

            <div class="mt-4">
                @Html.ActionLink("Chỉnh sửa", "Edit", new { id = Model.ProductID }, new { @class = "btn btn-warning me-2" })
                @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary" })
            </div>
        </div>
    </div>
</div>
