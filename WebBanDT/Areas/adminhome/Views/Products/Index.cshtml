@using System.Collections.Generic
@model PagedList.IPagedList<WebBanDT.Models.Product>
@using PagedList.Mvc;

@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Areas/AdminHome/Views/Shared/_AdminLayout.cshtml";

    // Danh sách ProductID đã từng được mua (từ ViewBag)
    var purchasedIds = ViewBag.PurchasedProductIds as List<int> ?? new List<int>();
}

<div class="card-body">
    @* Thông báo lỗi / thành công *@
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @* ✅ Form tìm kiếm *@
    @using (Html.BeginForm(
                "Index",
                "Products",
                new { area = "AdminHome" },           // route values
                FormMethod.Get,
                new { @class = "d-flex mb-3" }        // html attributes
           ))
    {
        <input type="text" name="searchString" value="@ViewBag.SearchString"
               class="form-control me-2" placeholder="🔍 Nhập tên sản phẩm..." />
        <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
    }
</div>

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="fa fa-box"></i> Danh sách sản phẩm</h4>
            <a href="@Url.Action("Create", "Products", new { area = "AdminHome" })" class="btn btn-light btn-sm">
                <i class="fa fa-plus-circle"></i> Thêm sản phẩm
            </a>
        </div>

        <div class="card-body">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-primary text-center">
                    <tr>
                        <th>Tên sản phẩm</th>
                        <th>Mô tả</th>
                        <th>Giá bán (VNĐ)</th>
                        <th>Tồn kho</th>
                        <th>Hình ảnh</th>
                        <th>Ngày tạo</th>
                        <th>Trạng thái</th>
                        <th>Danh mục</th>
                        <th>Thương hiệu</th>
                        <th>Phiên bản</th>
                        <th>Màu sắc</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.ProductName</td>

                                <td style="max-width: 250px;" class="text-truncate">
                                    @item.ProductDescription
                                </td>

                                <td class="text-end">
                                    @string.Format("{0:N0}", item.ProductPrice)
                                </td>

                                <td class="text-center">@item.StockQuantity</td>

                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(item.ProductImage))
                                    {
                                        <img src="@item.ProductImage" alt="@item.ProductName"
                                             width="60" height="60" class="rounded border" />
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Chưa có ảnh</span>
                                    }
                                </td>

                                <td class="text-center">
                                    @(item.CreatedAt.HasValue ? item.CreatedAt.Value.ToString("dd/MM/yyyy") : "Chưa có")
                                </td>

                                <td class="text-center">
                                    @if (item.IsActive == true)
                                    {
                                        <span class="badge bg-success">Hiển thị</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Ẩn</span>
                                    }
                                </td>

                                <td class="text-center">
                                    @(item.Category != null ? item.Category.CategoryName : "Không có")
                                </td>

                                <td class="text-center">
                                    @(item.Brand != null ? item.Brand.BrandName : "Không có")
                                </td>

                                @* ✅ Số lượng phiên bản *@
                                <td class="text-center">
                                    @{
                                        var verCount = (item.ProductVersions != null)
                                            ? item.ProductVersions.Count()
                                            : 0;
                                    }
                                    @if (verCount > 0)
                                    {
                                        <span class="badge bg-info">@verCount phiên bản</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>

                                @* ✅ Số lượng màu sắc *@
                                <td class="text-center">
                                    @{
                                        var colorCount = (item.ProductColors != null)
                                            ? item.ProductColors.Count()
                                            : 0;
                                    }
                                    @if (colorCount > 0)
                                    {
                                        <span class="badge bg-dark">@colorCount màu</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>

                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a href="@Url.Action("Edit", "Products", new { id = item.ProductID, area = "AdminHome" })"
                                           class="btn btn-sm btn-warning text-white" title="Sửa sản phẩm">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                        <a href="@Url.Action("Details", "Products", new { id = item.ProductID, area = "AdminHome" })"
                                           class="btn btn-sm btn-info text-white" title="Xem chi tiết">
                                            <i class="fa fa-eye"></i>
                                        </a>

                                        @* ✅ ĐÃ TỪNG ĐƯỢC MUA → KHÔNG THỂ XÓA *@
                                        @if (purchasedIds.Contains(item.ProductID))
                                        {
                                            <button class="btn btn-sm btn-secondary"
                                                    title="Sản phẩm này đã được khách hàng mua, không thể xóa"
                                                    disabled>
                                                <i class="fa fa-ban"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("Delete", "Products", new { id = item.ProductID, area = "AdminHome" })"
                                               class="btn btn-sm btn-danger" title="Xóa sản phẩm"
                                               onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này không?');">
                                                <i class="fa fa-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="12" class="text-center text-muted py-4">
                                <i class="fa fa-circle-exclamation"></i> Không có sản phẩm nào để hiển thị.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="d-flex justify-content-center mt-3">
                @Html.PagedListPager(
                    Model,
                    page => Url.Action("Index", new { page, searchString = ViewBag.SearchString }),
                    new PagedListRenderOptions
                    {
                        DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                        DisplayLinkToLastPage = PagedListDisplayMode.Always,
                        DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                        DisplayLinkToNextPage = PagedListDisplayMode.Always,
                        MaximumPageNumbersToDisplay = 5,
                        UlElementClasses = new[] { "pagination", "justify-content-center" },
                        LiElementClasses = new[] { "page-item" },
                        ContainerDivClasses = new[] { "d-flex", "justify-content-center" },
                        DisplayEllipsesWhenNotShowingAllPageNumbers = true,
                        LinkToPreviousPageFormat = "«",
                        LinkToNextPageFormat = "»",
                        LinkToFirstPageFormat = "Trang đầu",
                        LinkToLastPageFormat = "Trang cuối"
                    }
                )
            </div>
        </div>
    </div>
</div>

<style>
    .pagination > li > a,
    .pagination > li > span {
        color: #0d6efd;
        border: 1px solid #dee2e6;
        padding: 8px 12px;
        border-radius: 6px;
        margin: 0 3px;
        text-decoration: none;
    }

    .pagination > .active > a {
        background-color: #0d6efd !important;
        border-color: #0d6efd !important;
        color: white !important;
    }
</style>
