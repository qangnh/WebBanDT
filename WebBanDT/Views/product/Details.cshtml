@model WebBanDT.Models.ViewModels.ProductVM
@{
    ViewBag.Title = Model.ProductName;
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";

    // ✅ Nếu có màu nào có ảnh riêng thì dùng ảnh màu đầu tiên làm ảnh chính
    string mainImage = Model.ProductImage;
    if (Model.Colors != null && Model.Colors.Any(c => !string.IsNullOrEmpty(c.ColorImage)))
    {
        mainImage = Model.Colors.First(c => !string.IsNullOrEmpty(c.ColorImage)).ColorImage;
    }
}

<br />
<br />

<div class="product-page">
    <div class="container">

        <!-- breadcrumb -->
        <nav style="font-size:13px;color:#888;margin-bottom:8px">
            <span>@Model.CategoryName</span> /
            <strong>@Model.ProductName</strong>
        </nav>

        <!-- ===== HÀNG 1: 3 CỘT ===== -->
        <div class="top-3col">

            <!-- GALLERY -->
            <section class="gal">
                <img id="mainImg" class="gal-main" src="@mainImage" alt="@Model.ProductName">
                @if (Model.ProductImages != null && Model.ProductImages.Any())
                {
                    <div class="gal-thumbs" id="thumbs">
                        @foreach (var img in Model.ProductImages)
                        {
                            <button class="gal-thumb @(img == mainImage ? "is-active" : "")">
                                <img data-src="@img" src="@img" alt="@Model.ProductName" />
                            </button>
                        }
                    </div>
                }
            </section>

            <!-- INFO -->
            <section>
                <h1 class="title">@Model.ProductName</h1>

                <div class="meta">
                    <div>
                        <strong>@Model.Rating.ToString("0.0")</strong>
                        @for (int i = 0; i < 5; i++)
                        {
                            <i class="fa-solid fa-star" style="color:#f5a623"></i>
                        }
                    </div>
                    <div class="dot"></div>
                    <span>@Model.ReviewCount đánh giá</span>
                    <div class="dot"></div>
                    <span>Đã bán @Model.SoldQuantity+</span>
                </div>

                <div class="price-card">
                    <div style="display:flex;align-items:center">
                        <div class="price-now">
                            <span id="priceNowValue"
                                  data-base-price="@Model.ProductPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                @Model.ProductPrice.ToString("N0")
                            </span><sup>đ</sup>
                        </div>
                        @if (Model.OldPrice != null)
                        {
                            <div class="price-old">
                                <span id="priceOldValue"
                                      data-old-price="@Model.OldPrice.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                    @Model.OldPrice.Value.ToString("N0")
                                </span><sup>đ</sup>
                            </div>
                            <div class="price-off" id="priceOff">
                                @Math.Round((1 - (double)(Model.ProductPrice / Model.OldPrice.Value)) * 100)%
                            </div>
                        }
                    </div>
                    <div class="ship">
                        <i class="fa-solid fa-truck-fast"></i>
                        <span>Nhận trong <strong>2-3 ngày</strong> • <u>Miễn phí vận chuyển</u></span>
                    </div>
                </div>


                <!-- ✅ PHIÊN BẢN SẢN PHẨM -->
                @if (Model.Versions != null && Model.Versions.Any())
                {
                    <div class="pickers" style="grid-template-columns:120px auto;margin-top:12px;">
                        <div class="label">Phiên bản</div>
                        <div>
                            @foreach (var ver in Model.Versions.OrderBy(v => v.VersionName))
                            {
                                // Nếu VersionPrice null → dùng giá gốc sản phẩm
                                var effectivePrice = ver.VersionPrice ?? Model.ProductPrice;

                                <label class="btn btn-outline-secondary me-2 mb-2 js-version-option"
                                       style="font-size:13px;border-width:1px;"
                                       data-id="@ver.VersionID"
                                       data-price="@effectivePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                    <input type="radio" name="SelectedVersion" value="@ver.VersionID" class="d-none" />
                                    <span>@ver.VersionName</span><br />
                                    <small class="text-muted">
                                        @String.Format("{0:N0} đ", effectivePrice)
                                    </small>
                                </label>
                            }
                        </div>
                    </div>
                }


                <!-- ✅ MÀU SẮC SẢN PHẨM (mỗi màu một ảnh) -->
                @if (Model.Colors != null && Model.Colors.Any())
                {
                    <div class="pickers" style="grid-template-columns:120px auto;margin-top:12px;">
                        <div class="label">Màu sắc</div>
                        <div class="d-flex flex-wrap" style="gap:8px;">
                            @foreach (var color in Model.Colors.OrderBy(c => c.ColorName))
                            {
                                var hasImg = !string.IsNullOrEmpty(color.ColorImage);
                                <label class="js-color-option"
                                       data-id="@color.ColorID"
                                       data-image="@(hasImg ? color.ColorImage : "")"
                                       style="cursor:pointer;border:1px solid #ddd;border-radius:6px;padding:6px 8px;display:inline-flex;flex-direction:column;align-items:center;min-width:70px;">

                                    <!-- Không cần dùng radio nữa cũng được -->
                                    @* <input type="radio"
                                        name="SelectedColor"
                                        value="@color.ColorID"
                                        class="d-none" /> *@

                                    @if (hasImg)
                                    {
                                        <img src="@color.ColorImage"
                                             alt="@color.ColorName"
                                             style="width:40px;height:40px;object-fit:cover;border-radius:4px;margin-bottom:4px;" />
                                    }
                                    else
                                    {
                                        <div style="width:40px;height:40px;border-radius:4px;border:1px dashed #ccc;
                                    display:flex;align-items:center;justify-content:center;
                                    font-size:11px;color:#999;margin-bottom:4px;">
                                            No Img
                                        </div>
                                    }
                                    <span style="font-size:12px;">@color.ColorName</span>
                                </label>
                            }
                        </div>
                    </div>
                }


                <div class="pickers" style="grid-template-columns:120px auto;margin-top:12px;">
                    <div class="label">Số lượng còn</div>
                    <div class="qty">@Model.StockQuantity</div>
                </div>

                <div class="cta" style="display:flex;gap:10px;align-items:center;margin-top:12px;">
                    <!-- CHỌN SỐ LƯỢNG -->
                    <div class="qty-wrapper" style="display:flex;align-items:center;border:1px solid #ccc;border-radius:8px;overflow:hidden;width:110px;">
                        <button type="button" class="qty-btn" onclick="changeQty(-1)"
                                style="width:35px;height:35px;border:none;background:#f0f0f0;font-size:18px;cursor:pointer;">
                            –
                        </button>
                        <input type="number" id="productQty" name="quantity" value="1" min="1" max="@Model.StockQuantity"
                               style="flex:1;text-align:center;font-size:16px;border:none;outline:none;padding:5px 0;" />
                        <button type="button" class="qty-btn" onclick="changeQty(1)"
                                style="width:35px;height:35px;border:none;background:#f0f0f0;font-size:18px;cursor:pointer;">
                            +
                        </button>
                    </div>

                    <!-- THÊM VÀO GIỎ HÀNG -->
                    <form action="@Url.Action("AddToCart", "Cart")" method="post" style="margin:0;">
                        <input type="hidden" name="productId" value="@Model.ProductID" />
                        <input type="hidden" name="quantity" id="addToCartQty" value="1" />
                        <input type="hidden" name="versionId" id="selectedVersionIdForCart" />
                        <input type="hidden" name="colorId" id="selectedColorIdForCart" />   <!-- 🔴 THÊM -->
                        <button type="submit" class="btn-outline">
                            <i class="fa-solid fa-cart-shopping" style="margin-right:6px"></i>
                            Thêm Vào Giỏ Hàng
                        </button>
                    </form>

                    <form action="@Url.Action("BuyNow", "Cart")" method="post" style="margin:0;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.ProductID" />
                        <input type="hidden" name="quantity" id="buyNowQty" value="1" />
                        <input type="hidden" name="versionId" id="selectedVersionIdForBuy" />
                        <input type="hidden" name="colorId" id="selectedColorIdForBuy" />
                        <button type="submit" class="btn-buy">Mua Ngay</button>
                    </form>



                </div>

                <script>
                    function changeQty(delta) {
                        const input = document.getElementById('productQty');
                        let value = parseInt(input.value) || 1;
                        const min = parseInt(input.min) || 1;
                        const max = parseInt(input.max) || 100;
                        value += delta;
                        if (value < min) value = min;
                        if (value > max) value = max;
                        input.value = value;

                        // Đồng bộ giá trị với 2 form
                        document.getElementById('addToCartQty').value = value;
                        document.getElementById('buyNowQty').value = value;
                    }
                </script>

                <script>
                    // Đồng bộ số lượng với 2 form
                    const qtyInput = document.getElementById('productQty');
                    const addToCartQty = document.getElementById('addToCartQty');
                    const buyNowQty = document.getElementById('buyNowQty');

                    qtyInput.addEventListener('input', () => {
                        let val = Math.max(1, Math.min(parseInt(qtyInput.value) || 1, @Model.StockQuantity));
                        qtyInput.value = val;
                        addToCartQty.value = val;
                        buyNowQty.value = val;
                    });
                </script>

            </section>

            <!-- SIDEBAR STICKY -->
            <aside class="sticky">
                <div class="card">
                    <h3>Thông tin vận chuyển</h3>
                    <div class="line">
                        <i class="fa-solid fa-location-dot"></i>
                        <span>Chọn chi nhánh nhận hàng</span>
                    </div>
                    <div class="line">
                        <i class="fa-solid fa-truck-fast"></i>
                        <span>Giao hàng nhanh, miễn phí toàn quốc</span>
                    </div>
                </div>
            </aside>
        </div>

        <!-- ===== THÔNG SỐ KỸ THUẬT + MÔ TẢ ===== -->
        <div class="mid-2col">
            <div>
                <div class="card">
                    <h3>Cam kết sản phẩm</h3>
                    <div class="line"><i class="fa-solid fa-mobile-screen-button"></i> Máy mới 100% - Chính hãng</div>
                    <div class="line"><i class="fa-solid fa-shield-halved"></i> Bảo hành 12 tháng, 1 đổi 1 trong 30 ngày</div>
                    <div class="line"><i class="fa-solid fa-square-check"></i> Giá đã bao gồm VAT</div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Specifications))
                {
                    <div class="card" style="margin-top:12px">
                        <h3>Thông số kỹ thuật</h3>
                        @Html.Raw(Model.Specifications)
                    </div>
                }

                <!-- ===== MÔ TẢ SẢN PHẨM ===== -->
                @if (!string.IsNullOrEmpty(Model.ProductDescription))
                {
                    <section class="card product-desc" style="margin-top:20px">
                        <h3>Mô tả sản phẩm</h3>
                        <div class="desc-content">
                            @Html.Raw(Model.ProductDescription)
                        </div>
                    </section>
                }
            </div>

            <!-- SIDEBAR PHẢI -->
            <aside class="sticky">
                <div class="card">
                    <h3>Chọn nơi nhận</h3>
                    <div class="line"><i class="fa-solid fa-store"></i> Cửa hàng gần bạn</div>
                    <div class="line"><i class="fa-solid fa-circle-info"></i> Hỗ trợ đổi trả 15 ngày</div>
                </div>
                <div class="card promo">
                    <strong>Ưu đãi thêm</strong>
                    <ul style="margin-top:8px">
                        <li>Mở thẻ VPBank giảm tới 500.000đ</li>
                        <li>Trả góp 0% qua thẻ tín dụng</li>
                    </ul>
                </div>
            </aside>
        </div>

        <!-- ===== GỢI Ý SẢN PHẨM ===== -->
        @if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
        {
            <section class="card reco">
                <h3>Có thể bạn cũng thích</h3>
                <div class="reco-grid">
                    @foreach (var p in Model.RelatedProducts)
                    {
                        <div class="reco-card">
                            <img class="reco-img" src="@p.ProductImage" />
                            <div class="reco-title">@p.ProductName</div>
                            <div class="reco-price">@p.ProductPrice.ToString("N0")đ</div>
                        </div>
                    }
                </div>
            </section>
        }
    </div>
</div>

<script>
    // ✅ Đổi ảnh + set colorId khi chọn màu
    (function () {
        var colorOptions = document.querySelectorAll('.js-color-option');
        var mainImg = document.getElementById('mainImg');

        // hidden để gửi lên server
        var colorIdCart = document.getElementById('selectedColorIdForCart');
        var colorIdBuy = document.getElementById('selectedColorIdForBuy');

        if (!colorOptions.length) return;

        colorOptions.forEach(function (opt) {
            opt.addEventListener('click', function () {
                var imgUrl = this.getAttribute('data-image');
                var colorId = this.getAttribute('data-id'); // 🔥 LẤY TỪ data-id

                // Đổi ảnh chính theo màu
                if (imgUrl && mainImg) {
                    mainImg.src = imgUrl;
                }

                // Gán ColorID vào 2 hidden input
                if (colorIdCart) colorIdCart.value = colorId;
                if (colorIdBuy) colorIdBuy.value = colorId;

                // Highlight màu đang chọn
                colorOptions.forEach(function (o) {
                    o.style.borderColor = '#ddd';
                });
                this.style.borderColor = '#f53d2f';
            });
        });
    })();
</script>


<script>
    // ====== CẬP NHẬT GIÁ KHI CHỌN PHIÊN BẢN ======
    (function () {
        var priceNowEl = document.getElementById('priceNowValue');
        if (!priceNowEl) return;

        // Giá gốc (khi chưa chọn phiên bản nào hoặc phiên bản không có giá riêng)
        var basePrice = parseFloat(priceNowEl.dataset.basePrice.replace(',', '.'));

        var oldPriceEl = document.getElementById('priceOldValue');
        var oldPrice = null;
        if (oldPriceEl && oldPriceEl.dataset.oldPrice) {
            oldPrice = parseFloat(oldPriceEl.dataset.oldPrice.replace(',', '.'));
        }

        var versionInputs = document.querySelectorAll('.js-version-option');
        var versionIdCart = document.getElementById('selectedVersionIdForCart');
        var versionIdBuy = document.getElementById('selectedVersionIdForBuy');

        function formatVND(value) {
            return value.toLocaleString('vi-VN');
        }

        function updatePriceDisplay(newPrice) {
            if (!newPrice || isNaN(newPrice)) newPrice = basePrice;
            priceNowEl.textContent = formatVND(newPrice);

            // Cập nhật % giảm nếu có giá cũ
            var offEl = document.getElementById('priceOff');
            if (offEl && oldPrice && !isNaN(oldPrice) && oldPrice > 0) {
                var percent = Math.round((1 - (newPrice / oldPrice)) * 100);
                offEl.textContent = percent + '%';
            }
        }

        versionInputs.forEach(function (opt) {
            opt.addEventListener('click', function () {
                var priceStr = this.getAttribute('data-price') || '';
                var verId = this.getAttribute('data-id');

                var newPrice = parseFloat(priceStr.replace(',', '.'));
                if (!newPrice || isNaN(newPrice)) {
                    newPrice = basePrice;
                }

                // Đổi giá hiển thị
                updatePriceDisplay(newPrice);

                // Highlight ô được chọn
                versionInputs.forEach(function (o) {
                    o.style.borderColor = '#ddd';
                });
                this.style.borderColor = '#f53d2f';

                // Gán versionId vào hidden (nếu có)
                if (versionIdCart) versionIdCart.value = verId;
                if (versionIdBuy) versionIdBuy.value = verId;
            });
        });
    })();
</script>
