@model WebBanDT.Models.Order
@{
    ViewBag.Title = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}
<link href="~/Content/checkout.css" rel="stylesheet" />
<br />
<div class="order-success-container" style="text-align:center; margin: 60px auto;">
    <i class="fa-solid fa-circle-check" style="color:#28a745; font-size:80px; margin-bottom:20px;"></i>

    <h2>Đặt hàng thành công!</h2>
    <p>Cảm ơn bạn đã mua sắm tại <strong>Good Phones</strong>.</p>

    <div class="order-info" style="margin-top: 30px; text-align:left; width: 80%; margin-left:auto; margin-right:auto;">
        <h4>Thông tin đơn hàng</h4>
        <table style="margin-bottom:20px; border-collapse: collapse; width:100%;" class="table table-bordered">
            <tr>
                <td>Mã đơn hàng:</td>
                <td>@Model.OrderID</td>
            </tr>
            <tr>
                <td>Ngày đặt hàng:</td>
                <td>@(Model.OrderDate.HasValue ? Model.OrderDate.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
            </tr>
            <tr>
                <td>Tổng tiền:</td>
                <td style="color:#d9534f; font-weight:bold;">@Model.TotalAmount.ToString("N0") ₫</td>
            </tr>
            <tr>
                <td>Họ tên khách hàng:</td>
                <td>@Model.Customer.CustomerName</td>
            </tr>
            <tr>
                <td>SĐT khách hàng:</td>
                <td>@Model.Customer.CustomerPhone</td>
            </tr>
            <tr>
                <td>Địa chỉ giao hàng:</td>
                <td>@Model.DeliveryAddress</td>
            </tr>
            <tr>
                <td>Trạng thái đơn hàng:</td>
                <td>@Model.OrderStatus</td>
            </tr>
        </table>

        <h4>Chi tiết sản phẩm</h4>
        <table class="table table-striped table-bordered" style="border-collapse: collapse; width:100%;">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Phiên bản</th>
                    <th>Màu sắc</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderDetails)
                {
                    <tr>
                        <td>@item.Product.ProductName</td>

                        <!-- Phiên bản -->
                        <td>
                            @if (item.ProductVersion != null)
                            {
                                @item.ProductVersion.VersionName
                            }
                            else
                            {
                                @:-
                            }
                        </td>

                        <!-- Màu sắc -->
                        <td>
                            @if (item.ProductColor != null)
                            {
                                @item.ProductColor.ColorName
                            }
                            else
                            {
                                @:-
                            }
                        </td>

                        <td>@item.UnitPrice.ToString("N0") ₫</td>
                        <td>@item.Quantity</td>
                        <td>@((item.UnitPrice * item.Quantity).ToString("N0")) ₫</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="5" style="text-align:right;"><strong>Tổng thanh toán:</strong></td>
                    <td><strong>@Model.TotalAmount.ToString("N0") ₫</strong></td>
                </tr>
            </tfoot>
        </table>

    </div>

    <div style="margin-top: 40px;">
        <a href="@Url.Action("Index", "CustomerHome")" class="btn btn-success">
            <i class="fa-solid fa-house"></i> Tiếp tục mua sắm
        </a>
    </div>
</div>
