@model WebBanDT.Models.viewmodels.CheckoutViewModel

@{
    ViewBag.Title = "Thanh toán";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";

    var cart = Session["Cart"] as WebBanDT.Models.Cart;
    if (cart != null && cart.CartItems != null)
    {
        Model.Cart = cart;
        Model.TotalAmount = cart.CartItems.Sum(i => i.Product.ProductPrice * i.Quantity);
    }
}

<h2>Thanh toán</h2>

@if (Model.Cart == null || Model.Cart.CartItems == null || !Model.Cart.CartItems.Any())
{
    <p>Giỏ hàng của bạn đang trống. <a href="@Url.Action("Index","Product")">Quay lại mua sắm</a></p>
}
else
{
    <h3>Giỏ hàng</h3>
    <table class="table table-bordered" style="width:70%; margin-bottom:20px;">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Đơn giá</th>
                <th>Số lượng</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Cart.CartItems)
            {
                <tr>
                    <td>@item.Product.ProductName</td>
                    <td>@item.Product.ProductPrice.ToString("N0") ₫</td>
                    <td>@item.Quantity</td>
                    <td>@(item.Product.ProductPrice * item.Quantity).ToString("N0") ₫</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" style="text-align:right;"><strong>Tổng tiền:</strong></td>
                <td><strong>@Model.TotalAmount.ToString("N0") ₫</strong></td>
            </tr>
        </tfoot>
    </table>

    <form action="@Url.Action("Checkout","Order")" method="post">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label>Họ và tên</label>
            <input type="text" name="FullName" value="@Model.FullName" class="form-control" placeholder="Nhập họ và tên" required />
        </div>

        <div class="form-group">
            <label>Số điện thoại</label>
            <input type="text" name="Phone" value="@Model.Phone" class="form-control" placeholder="Nhập số điện thoại" required />
        </div>

        <div class="form-group">
            <label>Email</label>
            <input type="email" name="Email" value="@Model.Email" class="form-control" placeholder="Nhập email (tùy chọn)" />
        </div>

        <div class="form-group">
            <label>Địa chỉ giao hàng</label>
            <input type="text" name="DeliveryAddress" value="@Model.DeliveryAddress" class="form-control" placeholder="Nhập địa chỉ giao hàng" required />
        </div>

        <div class="form-group">
            <label>Ghi chú đơn hàng</label>
            <textarea name="OrderNote" class="form-control" placeholder="Ghi chú về đơn hàng (tùy chọn)">@Model.OrderNote</textarea>
        </div>

        <div class="form-group">
            <label>Tổng thanh toán:</label>
            <span class="font-weight-bold">@Model.TotalAmount.ToString("N0") ₫</span>
        </div>

        <button type="submit" class="btn btn-success">Xác nhận thanh toán</button>
    </form>
}
