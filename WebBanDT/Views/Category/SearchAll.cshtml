@model IEnumerable<WebBanDT.Models.ViewModels.ProductVM>
@{
    ViewBag.Title = "Kết quả tìm kiếm";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    var keyword = ViewBag.SearchKeyword as string;
    var resultCount = ViewBag.ResultCount ?? 0;
}

<div id="content">
    <!-- Search Header -->
    <div class="search-result-header">
        <h1 class="search-result-title">
            <i class="fa-solid fa-magnifying-glass"></i>
            Kết quả tìm kiếm cho: <span class="keyword">"@keyword"</span>
        </h1>
        <p class="search-result-count">Tìm thấy <strong>@resultCount</strong> sản phẩm</p>
    </div>

    @{
        var keywordFromRequest = Request["keyword"] ?? (keyword ?? "");
        var minPrice = Request["minPrice"];
        var maxPrice = Request["maxPrice"];
    }

    @using (Html.BeginForm("SearchAll", "Category", FormMethod.Get, new { @class = "search-filter-form" }))
    {
        <!-- HÀNG TRÊN: THANH TÌM KIẾM -->
        <div class="search-row">
            <input type="text"
                   name="keyword"
                   placeholder="Tìm sản phẩm theo tên, hãng..."
                   value="@keywordFromRequest" />

            <button type="submit" class="btn-search">
                <i class="fa-solid fa-magnifying-glass"></i>
            </button>
        </div>

        <!-- HÀNG DƯỚI: LỌC GIÁ -->
        <div class="filter-form">
            <input type="number"
                   name="minPrice"
                   placeholder="Giá từ"
                   min="0"
                   value="@minPrice" />

            <input type="number"
                   name="maxPrice"
                   placeholder="Đến"
                   min="0"
                   value="@maxPrice" />

            <button type="submit" class="btn-filter">
                <i class="fa-solid fa-filter"></i> Lọc
            </button>
        </div>
    }



    <!-- Results -->
    @if (Model != null && Model.Any())
    {
        <div class="product-wrap">
            <div class="s-product-row">
                @Html.Partial("_ProductList", Model)
            </div>
        </div>
    }
    else
    {
        <div class="no-results">
            <i class="fa-solid fa-box-open"></i>
            <h3>Không tìm thấy sản phẩm phù hợp</h3>
            <p>Vui lòng thử với từ khóa khác hoặc xem các sản phẩm phổ biến</p>
            <a href="@Url.Action("Index", "CustomerHome")" class="btn-back-home">
                <i class="fa-solid fa-house"></i> Về trang chủ
            </a>
        </div>
    }
</div>

<style>
    .search-filter-form {
        max-width: 700px;
        margin: 0 auto 20px;
    }

    .search-row {
        display: flex;
        align-items: center;
        margin-bottom: 8px;
    }

        .search-row input[type="text"] {
            flex: 1;
            padding: 8px 10px;
            border: 1px solid #ccc;
            border-right: none;
            border-radius: 6px 0 0 6px;
        }

    .btn-search {
        padding: 8px 12px;
        border: 1px solid #ccc;
        border-radius: 0 6px 6px 0;
        background: #fff;
        cursor: pointer;
    }

    .filter-form {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #fff;
        padding: 8px 12px;
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0,0,0,.05);
    }

        .filter-form input[type="number"] {
            flex: 1;
            padding: 8px 10px;
            border: 1px solid #ddd;
            border-radius: 6px;
        }

    .btn-filter {
        padding: 8px 16px;
        background: #ff8c00;
        color: #fff;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
    }


</style>