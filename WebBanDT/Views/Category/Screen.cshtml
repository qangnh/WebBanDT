@model IEnumerable<WebBanDT.Models.ViewModels.ProductVM>
@{
    ViewBag.Title = "MÀN HÌNH";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<br />


<div id="content">
    @using (Html.BeginForm("Screen", "Category", FormMethod.Get))
    {
        

        <div class="filter-form">
            <input type="number" name="minPrice" placeholder="Giá từ" min="0" value="@Request.QueryString["minPrice"]" />
            <input type="number" name="maxPrice" placeholder="Đến" min="0" value="@Request.QueryString["maxPrice"]" />
            <button type="submit">Lọc</button>
        </div>
    }

    <div class="category-header">
        <h2 class="category-title">MÀN HÌNH</h2>
    </div>

    @if (!Model.Any())
    {
        <div style="text-align: center; padding: 40px; color: #999; font-size: 16px;">
            <i class="fa-solid fa-box-open" style="font-size: 48px; margin-bottom: 15px; display: block;"></i>
            <p>Không tìm thấy sản phẩm phù hợp.</p>
            <p style="font-size: 14px; margin-top: 10px;">Vui lòng thử lại với từ khóa hoặc khoảng giá khác.</p>
        </div>
    }

    @Html.Partial("_ProductList", Model)
</div>
