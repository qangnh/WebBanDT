@model IEnumerable<WebBanDT.Models.ViewModels.ProductVM>
@{
    ViewBag.Title = "Tất Cả Sản Phẩm";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}
<div id="content">
    <!-- Form tìm kiếm và lọc -->
    @using (Html.BeginForm("FullProduct", "Category", FormMethod.Get))
    {
        <!-- Thanh tìm kiếm
        <div class="search-section">
            <div class="search-container">
                <input type="text"
                       name="keyword"
                       placeholder="Tìm sản phẩm theo tên, hãng..."
                       class="search-input"
                       value="@Request.QueryString["keyword"]" />
                <button type="submit" class="search-btn">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </div>
        </div> -->
        <!-- Bộ lọc giá -->
        <div class="filter-form">
            <input type="number"
                   name="minPrice"
                   placeholder="Giá từ"
                   min="0"
                   value="@Request.QueryString["minPrice"]" />
            <input type="number"
                   name="maxPrice"
                   placeholder="Đến"
                   min="0"
                   value="@Request.QueryString["maxPrice"]" />
            <button type="submit">Lọc</button>
        </div>
    }
    <!-- Tiêu đề Tất Cả Sản Phẩm -->
    <div class="category-header">
        <h2 class="category-title">TẤT CẢ SẢN PHẨM</h2>
    </div>
    <!-- Thông báo nếu không có sản phẩm -->
    @if (Model != null && !Model.Any())
    {
        <div style="text-align: center; padding: 60px 20px; color: #999;">
            <i class="fa-solid fa-box-open" style="font-size: 64px; margin-bottom: 20px; display: block; color: #e0e0e0;"></i>
            <p style="font-size: 18px; font-weight: 600; color: #666; margin: 10px 0;">Không tìm thấy sản phẩm phù hợp</p>
            <p style="font-size: 14px; margin-top: 10px;">Vui lòng thử lại với từ khóa hoặc khoảng giá khác.</p>
        </div>
    }
    else if (Model != null)
    {
        <!-- Product wrapper -->
        <div class="product-wrap">
            <div class="s-product-row">
                <!-- Danh sách sản phẩm -->
                @Html.Partial("_ProductList", Model)
            </div>
        </div>
    }
</div>
<style>
    /* Khối chung */
    .search-section {
        margin-bottom: 8px;
    }

    /* Container cho ô search */
    .search-container {
        display: flex;
        align-items: center;
        max-width: 500px;
        margin: 0 auto 6px;
    }

    /* Ô nhập từ khóa */
    .search-input {
        flex: 1;
        padding: 8px 10px;
        border: 1px solid #ddd;
        border-right: none;
        border-radius: 6px 0 0 6px;
        outline: none;
    }

    /* Nút kính lúp */
    .search-btn {
        padding: 8px 12px;
        border: 1px solid #ddd;
        border-radius: 0 6px 6px 0;
        background: #ff8c00;
        color: #fff;
        cursor: pointer;
    }

        .search-btn i {
            font-size: 14px;
        }

    /* Khối lọc giá – cho giống kiểu card trắng */
    .filter-form {
        display: flex;
        align-items: center;
        gap: 8px;
        max-width: 500px;
        margin: 0 auto 20px;
        background: #fff;
        padding: 8px 12px;
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0,0,0,.05);
    }

        .filter-form input[type="number"] {
            flex: 1;
            padding: 8px 10px;
            border: 1px solid #ddd;
            border-radius: 6px;
            outline: none;
        }

        .filter-form button {
            padding: 8px 16px;
            background: #ff8c00;
            color: #fff;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
        }
</style>