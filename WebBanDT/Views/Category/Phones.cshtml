@model IEnumerable<WebBanDT.Models.ViewModels.ProductVM>
@{
    ViewBag.Title = ViewBag.CategoryName;
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";

    var brands = ViewBag.Brands as IEnumerable<WebBanDT.Models.Brand>;
    var selectedBrandId = Request.QueryString["brandId"];
    var categoryId = Request.QueryString["categoryId"] ?? ViewBag.CategoryId?.ToString();
}

<div id="content">

    <!-- 🔹 DẢI LOGO THƯƠNG HIỆU -->
    @if (brands != null && brands.Any())
    {
        <div class="brands-section">
            <div class="brands-title">@ViewBag.CategoryName</div>
            <div class="brands-grid">
                <!-- Nút TẤT CẢ -->
                @{
                    var allRoute = new System.Web.Routing.RouteValueDictionary();
                    if (!string.IsNullOrEmpty(categoryId))
                    {
                        allRoute.Add("categoryId", categoryId);
                    }
                }
                <a href="@Url.Action(ViewContext.RouteData.Values["action"].ToString(),
                                    ViewContext.RouteData.Values["controller"].ToString(),
                                    allRoute)"
                   class="brand-item @(string.IsNullOrEmpty(selectedBrandId) ? "active" : "")">
                    <div class="brand-name">Tất cả</div>
                </a>

                <!-- Các logo brand -->
                @foreach (var brand in brands)
                {
                    var isActive = selectedBrandId == brand.BrandID.ToString();

                    var routeValues = new System.Web.Routing.RouteValueDictionary
                    {
                        { "brandId", brand.BrandID }
                    };
                    if (!string.IsNullOrEmpty(categoryId))
                    {
                        routeValues.Add("categoryId", categoryId);
                    }

                    var logoUrl = GetBrandLogoUrl(brand.BrandName);

                    <a href="@Url.Action(ViewContext.RouteData.Values["action"].ToString(),
                                        ViewContext.RouteData.Values["controller"].ToString(),
                                        routeValues)"
                       class="brand-item @(isActive ? "active" : "")">

                        @* Nếu có logo thì hiển thị hình, nếu không thì hiện chữ *@
                        @if (!string.IsNullOrEmpty(logoUrl))
                        {
                            <img src="@logoUrl" alt="@brand.BrandName"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                            <div class="brand-name" style="display:none">@brand.BrandName</div>
                        }
                        else
                        {
                            <div class="brand-name">@brand.BrandName</div>
                        }
                    </a>
                }
            </div>
        </div>
    }

    <!-- 🔹 THÔNG TIN HÃNG ĐANG CHỌN -->
    @if (!string.IsNullOrEmpty(selectedBrandId) && brands != null)
    {
        var selectedBrand = brands.FirstOrDefault(b => b.BrandID.ToString() == selectedBrandId);
        if (selectedBrand != null)
        {
            var clearBrandRoute = new System.Web.Routing.RouteValueDictionary();
            if (!string.IsNullOrEmpty(categoryId))
            {
                clearBrandRoute.Add("categoryId", categoryId);
            }

            <div class="active-brand-info">
                <span>Đang xem sản phẩm của hãng: <strong>@selectedBrand.BrandName</strong></span>
                <a href="@Url.Action(ViewContext.RouteData.Values["action"].ToString(),
                                    ViewContext.RouteData.Values["controller"].ToString(),
                                    clearBrandRoute)"
                   class="clear-filter">Xem tất cả</a>
            </div>
        }
    }

    <!-- 🔹 FORM LỌC THEO HÃNG + GIÁ -->
    @using (Html.BeginForm(ViewContext.RouteData.Values["action"].ToString(),
                           ViewContext.RouteData.Values["controller"].ToString(),
                           FormMethod.Get))
    {
        // luôn giữ categoryId
        if (!string.IsNullOrEmpty(categoryId))
        {
            <input type="hidden" name="categoryId" value="@categoryId" />
        }

        <div class="filter-form">
            @* CHỌN HÃNG (combo) *@
            <select name="brandId" class="brand-select">
                <option value="">Tất cả hãng</option>
                @if (brands != null)
                {
                    foreach (var b in brands)
                    {
                        <option value="@b.BrandID" @(selectedBrandId == b.BrandID.ToString() ? "selected" : "")>
                            @b.BrandName
                        </option>
                    }
                }
            </select>

            @* GIÁ TỪ *@
            <input type="number"
                   name="minPrice"
                   placeholder="Giá từ"
                   min="0"
                   value="@Request.QueryString["minPrice"]" />

            @* ĐẾN *@
            <input type="number"
                   name="maxPrice"
                   placeholder="Đến"
                   min="0"
                   value="@Request.QueryString["maxPrice"]" />

            <button type="submit">Lọc</button>

            @* Nút xóa LỌC GIÁ (giữ brand + category) *@
            @if (!string.IsNullOrEmpty(Request.QueryString["minPrice"]) ||
                 !string.IsNullOrEmpty(Request.QueryString["maxPrice"]))
            {
                var clearRouteValues = new System.Web.Routing.RouteValueDictionary();

                if (!string.IsNullOrEmpty(selectedBrandId))
                {
                    clearRouteValues.Add("brandId", selectedBrandId);
                }
                if (!string.IsNullOrEmpty(categoryId))
                {
                    clearRouteValues.Add("categoryId", categoryId);
                }

                <a href="@Url.Action(ViewContext.RouteData.Values["action"].ToString(),
                                    ViewContext.RouteData.Values["controller"].ToString(),
                                    clearRouteValues)"
                   class="clear-filter">Xóa lọc giá</a>
            }
        </div>
    }

    <!-- 🔹 TIÊU ĐỀ VÀ SỐ LƯỢNG -->
    <div class="category-header">
        <h2 class="category-title">
            @if (!string.IsNullOrEmpty(selectedBrandId) && brands != null)
            {
                var selectedBrand = brands.FirstOrDefault(b => b.BrandID.ToString() == selectedBrandId);
                if (selectedBrand != null)
                {
                    @($"{ViewBag.CategoryName} {selectedBrand.BrandName}")
                }
                else
                {
                    @ViewBag.CategoryName
                }
            }
            else
            {
                @ViewBag.CategoryName
            }
        </h2>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="product-count">
            Tìm thấy <strong>@Model.Count()</strong> sản phẩm
        </div>
    }

    <!-- 🔹 NẾU KHÔNG CÓ SẢN PHẨM -->
    @if (Model != null && !Model.Any())
    {
        <div style="text-align: center; padding: 60px 20px; color: #999;">
            <i class="fa-solid fa-box-open" style="font-size: 64px; margin-bottom: 20px; display: block; color: #e0e0e0;"></i>
            <p style="font-size: 18px; font-weight: 600; color: #666; margin: 10px 0;">Không tìm thấy sản phẩm phù hợp</p>
            <p style="font-size: 14px; margin-top: 10px;">Vui lòng thử lại với hãng hoặc khoảng giá khác.</p>
        </div>
    }
    else if (Model != null)
    {
        <div class="product-wrap">
            <div class="s-product-row">
                @Html.Partial("_ProductList", Model)
            </div>
        </div>
    }
</div>

